# Copy to .env and restart `npm start` after changing it.
# Backend base URL (no trailing slash). Defaults to http://localhost:5001 in development.
REACT_APP_API_URL=http://localhost:5001
# Browser key for the Google Maps JavaScript and Directions APIs.
# Restrict it by HTTP referrer in the Google Cloud console.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
